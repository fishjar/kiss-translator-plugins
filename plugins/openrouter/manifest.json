{
  "manifestVersion": 1,
  "id": "openrouter",
  "name": "OpenRouter",
  "version": "1.1.2",
  "apiVersion": "1",
  "icon": "assets/logo.png",
  "description": "OpenRouter 聊天与翻译，以及 Whisper、Qwen 音频转写。",
  "nameI18n": {
    "en": "OpenRouter"
  },
  "descriptionI18n": {
    "zh": "OpenRouter 聊天与翻译，以及 Whisper、Qwen 音频转写。",
    "en": "OpenRouter chat and translation, plus audio transcription with Whisper and Qwen.",
    "zh_TW": "OpenRouter 聊天與翻譯，以及 Whisper、Qwen 音訊轉寫。",
    "ja": "OpenRouter のチャットと翻訳、および Whisper と Qwen による音声文字起こし。",
    "ko": "OpenRouter 채팅 및 번역과 Whisper, Qwen을 이용한 음성 전사.",
    "tr": "OpenRouter sohbet ve çeviri; Whisper ve Qwen ile ses transkripsiyonu.",
    "vi": "Trò chuyện và dịch qua OpenRouter, cùng chép lời âm thanh bằng Whisper và Qwen.",
    "ru": "Чат и перевод OpenRouter, а также транскрипция аудио с Whisper и Qwen."
  },
  "permissions": {
    "network": [
      "https://openrouter.ai"
    ],
    "endpointFields": [
      "baseUrl"
    ]
  },
  "sharedSettings": [
    {
      "key": "baseUrl",
      "label": "API 基础地址",
      "labelI18n": {
        "zh": "API 基础地址",
        "en": "API base URL",
        "zh_TW": "API 基礎地址",
        "ja": "APIベースURL",
        "ko": "API 기본 URL",
        "tr": "API temel URL'si",
        "vi": "URL gốc API",
        "ru": "Базовый URL API"
      },
      "type": "text",
      "defaultValue": "https://openrouter.ai/api/v1",
      "required": true
    },
    {
      "key": "apiKey",
      "label": "OpenRouter API Key",
      "type": "password",
      "isSecret": true,
      "required": true
    }
  ],
  "services": [
    {
      "id": "chat-completions",
      "name": "聊天与翻译",
      "nameI18n": {
        "zh": "聊天与翻译",
        "en": "Chat and translation",
        "zh_TW": "聊天與翻譯",
        "ja": "チャットと翻訳",
        "ko": "채팅 및 번역",
        "tr": "Sohbet ve çeviri",
        "vi": "Trò chuyện và dịch",
        "ru": "Чат и перевод"
      },
      "implementation": {
        "kind": "declarative",
        "entry": "services/chat.json"
      },
      "capabilities": {
        "chat": {
          "handler": "chat",
          "inputModalities": [
            "text"
          ],
          "outputModes": [
            "complete",
            "stream"
          ]
        },
        "translate": {
          "handler": "translate",
          "batch": {
            "supported": true
          },
          "outputModes": [
            "complete",
            "stream"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "openai/gpt-6-luna",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "openai/gpt-6-luna",
          "name": "GPT-6 Luna"
        }
      ],
      "defaultPrompts": {
        "batch": {
          "protocol": "json",
          "systemPrompt": "Translate the input items from {{sourceLanguage}} to {{targetLanguage}}. Return only a JSON array of {id,text}, keeping every ID. Glossary: {{glossary}}. Context: {{context}}",
          "userPrompt": "{{segments}}"
        },
        "nobatch": {
          "protocol": "text",
          "systemPrompt": "Translate the source text from {{sourceLanguage}} to {{targetLanguage}}. Output only the translated text, without explanations or Markdown fences. Glossary: {{glossary}}. Context: {{context}}",
          "userPrompt": "{{text}}"
        }
      }
    },
    {
      "id": "transcriptions",
      "name": "音频转写",
      "nameI18n": {
        "zh": "音频转写",
        "en": "Audio transcription",
        "zh_TW": "音訊轉寫",
        "ja": "音声文字起こし",
        "ko": "음성 전사",
        "tr": "Ses transkripsiyonu",
        "vi": "Chép lời âm thanh",
        "ru": "Транскрипция аудио"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/transcribe.js"
      },
      "capabilities": {
        "transcribe": {
          "handler": "transcribe",
          "timestamps": true,
          "outputModes": [
            "complete"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "openai/whisper-large-v3-turbo",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "openai/whisper-large-v3-turbo",
          "name": "Whisper Large V3 Turbo"
        },
        {
          "id": "qwen/qwen3-asr-0.6b",
          "name": "Qwen3 ASR 0.6B"
        }
      ]
    }
  ]
}
