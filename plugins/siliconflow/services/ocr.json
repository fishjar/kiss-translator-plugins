{
  "rulesVersion": 2,
  "handlers": {
    "parseImage": {
      "protocol": "openai-chat-completions",
      "task": "parseImage",
      "request": {
        "baseUrl": {
          "$ref": "config.baseUrl"
        },
        "model": {
          "$ref": "config.model"
        },
        "auth": {
          "type": "bearer",
          "secret": {
            "$secret": "apiKey"
          }
        },
        "parameters": {
          "temperature": 0
        }
      }
    }
  }
}
