{
  "manifestVersion": 1,
  "id": "siliconflow",
  "name": "硅基流动 SiliconFlow",
  "nameI18n": {
    "en": "SiliconFlow"
  },
  "version": "1.1.2",
  "apiVersion": "1",
  "icon": "assets/logo.png",
  "description": "硅基流动：聊天与翻译、Qwen 和星辰音频转写，以及 PaddleOCR 和 DeepSeek OCR 图片全文识别。",
  "descriptionI18n": {
    "zh": "硅基流动：聊天与翻译、Qwen 和星辰音频转写，以及 PaddleOCR 和 DeepSeek OCR 图片全文识别。",
    "en": "SiliconFlow chat and translation, Qwen and XingChen audio transcription, and image text recognition with PaddleOCR and DeepSeek OCR.",
    "zh_TW": "矽基流動：聊天與翻譯、Qwen 與星辰音訊轉寫，以及 PaddleOCR 與 DeepSeek OCR 圖片全文辨識。",
    "ja": "SiliconFlow のチャットと翻訳、Qwen と XingChen による音声文字起こし、PaddleOCR と DeepSeek OCR による画像の全文認識。",
    "ko": "SiliconFlow 채팅 및 번역, Qwen과 XingChen 음성 전사, PaddleOCR과 DeepSeek OCR 이미지 전체 텍스트 인식.",
    "tr": "SiliconFlow sohbet ve çeviri, Qwen ve XingChen ile ses transkripsiyonu, PaddleOCR ve DeepSeek OCR ile görüntü metni tanıma.",
    "vi": "SiliconFlow: trò chuyện và dịch, chép lời âm thanh bằng Qwen và XingChen, nhận dạng văn bản trong ảnh bằng PaddleOCR và DeepSeek OCR.",
    "ru": "SiliconFlow: чат и перевод, транскрипция аудио с Qwen и XingChen, распознавание текста на изображениях с PaddleOCR и DeepSeek OCR."
  },
  "permissions": {
    "network": [
      "https://api.siliconflow.cn"
    ],
    "endpointFields": [
      "baseUrl"
    ]
  },
  "sharedSettings": [
    {
      "key": "baseUrl",
      "label": "API 基础地址（包含 /v1）",
      "labelI18n": {
        "zh": "API 基础地址（包含 /v1）",
        "en": "API base URL (including /v1)",
        "zh_TW": "API 基礎地址（包含 /v1）",
        "ja": "APIベースURL（/v1を含む）",
        "ko": "API 기본 URL (/v1 포함)",
        "tr": "API temel URL'si (/v1 dahil)",
        "vi": "URL gốc API (gồm /v1)",
        "ru": "Базовый URL API (включая /v1)"
      },
      "type": "text",
      "defaultValue": "https://api.siliconflow.cn/v1",
      "required": true
    },
    {
      "key": "apiKey",
      "label": "SiliconFlow API Key",
      "type": "password",
      "isSecret": true,
      "required": true
    }
  ],
  "services": [
    {
      "id": "chat-completions",
      "name": "聊天与翻译",
      "nameI18n": {
        "zh": "聊天与翻译",
        "en": "Chat and translation",
        "zh_TW": "聊天與翻譯",
        "ja": "チャットと翻訳",
        "ko": "채팅 및 번역",
        "tr": "Sohbet ve çeviri",
        "vi": "Trò chuyện và dịch",
        "ru": "Чат и перевод"
      },
      "implementation": {
        "kind": "declarative",
        "entry": "services/chat.json"
      },
      "capabilities": {
        "chat": {
          "handler": "chat",
          "inputModalities": [
            "text"
          ],
          "outputModes": [
            "complete",
            "stream"
          ]
        },
        "translate": {
          "handler": "translate",
          "batch": {
            "supported": true
          },
          "outputModes": [
            "complete",
            "stream"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "deepseek-ai/DeepSeek-V4.1-Flash",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "deepseek-ai/DeepSeek-V4.1-Flash",
          "name": "DeepSeek-V4.1-Flash"
        }
      ],
      "defaultPrompts": {
        "batch": {
          "protocol": "json",
          "systemPrompt": "Translate the input items from {{sourceLanguage}} to {{targetLanguage}}. Return only a JSON array of {id,text}, keeping every ID. Glossary: {{glossary}}. Context: {{context}}",
          "userPrompt": "{{segments}}"
        },
        "nobatch": {
          "protocol": "text",
          "systemPrompt": "Translate the source text from {{sourceLanguage}} to {{targetLanguage}}. Output only the translated text, without explanations or Markdown fences. Glossary: {{glossary}}. Context: {{context}}",
          "userPrompt": "{{text}}"
        }
      }
    },
    {
      "id": "transcriptions",
      "name": "音频转写（Qwen，无时间戳）",
      "nameI18n": {
        "zh": "音频转写（Qwen，无时间戳）",
        "en": "Audio transcription (Qwen, no timestamps)",
        "zh_TW": "音訊轉寫（Qwen，無時間戳）",
        "ja": "音声文字起こし（Qwen、タイムスタンプなし）",
        "ko": "음성 전사 (Qwen, 타임스탬프 없음)",
        "tr": "Ses transkripsiyonu (Qwen, zaman damgasız)",
        "vi": "Chép lời (Qwen, không có mốc thời gian)",
        "ru": "Транскрипция (Qwen, без временных меток)"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/transcribe.js"
      },
      "capabilities": {
        "transcribe": {
          "handler": "transcribe",
          "timestamps": false,
          "outputModes": [
            "complete"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "Qwen/Qwen3-ASR-1.7B",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "Qwen/Qwen3-ASR-1.7B",
          "name": "Qwen3-ASR-1.7B",
          "capabilities": {
            "transcribe": {
              "timestamps": false
            }
          }
        }
      ]
    },
    {
      "id": "xingchen-transcriptions",
      "name": "音频转写（星辰，分段时间戳）",
      "nameI18n": {
        "zh": "音频转写（星辰，分段时间戳）",
        "en": "Audio transcription (XingChen, segment timestamps)",
        "zh_TW": "音訊轉寫（星辰，分段時間戳）",
        "ja": "音声文字起こし（XingChen、区間タイムスタンプ）",
        "ko": "음성 전사 (XingChen, 구간 타임스탬프)",
        "tr": "Ses transkripsiyonu (XingChen, segment zaman damgaları)",
        "vi": "Chép lời (XingChen, mốc thời gian theo đoạn)",
        "ru": "Транскрипция (XingChen, метки сегментов)"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/transcribe.js"
      },
      "capabilities": {
        "transcribe": {
          "handler": "transcribe",
          "timestamps": true,
          "outputModes": [
            "complete"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "XingChenAGI/XingChenASR-V3.2-Ultra",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "XingChenAGI/XingChenASR-V3.2-Ultra",
          "name": "XingChenASR-V3.2-Ultra",
          "capabilities": {
            "transcribe": {
              "timestamps": true
            }
          }
        }
      ]
    },
    {
      "id": "paddleocr",
      "name": "图片全文识别（PaddleOCR）",
      "nameI18n": {
        "zh": "图片全文识别（PaddleOCR）",
        "en": "Image text recognition (PaddleOCR)",
        "zh_TW": "圖片全文辨識（PaddleOCR）",
        "ja": "画像の全文認識（PaddleOCR）",
        "ko": "이미지 전체 텍스트 인식 (PaddleOCR)",
        "tr": "Görüntü metni tanıma (PaddleOCR)",
        "vi": "Nhận dạng văn bản trong ảnh (PaddleOCR)",
        "ru": "Распознавание текста на изображении (PaddleOCR)"
      },
      "implementation": {
        "kind": "declarative",
        "entry": "services/ocr.json"
      },
      "capabilities": {
        "parseImage": {
          "handler": "parseImage",
          "inputModalities": [
            "image"
          ],
          "outputModes": [
            "complete"
          ],
          "taskModes": [
            "doc"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "PaddlePaddle/PaddleOCR-VL-1.5",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "PaddlePaddle/PaddleOCR-VL-1.5",
          "name": "PaddleOCR-VL-1.5"
        }
      ],
      "defaultPrompts": {
        "vlm": {
          "userPrompt": "OCR:"
        }
      }
    },
    {
      "id": "deepseek-ocr",
      "name": "图片全文识别（DeepSeek OCR）",
      "nameI18n": {
        "zh": "图片全文识别（DeepSeek OCR）",
        "en": "Image text recognition (DeepSeek OCR)",
        "zh_TW": "圖片全文辨識（DeepSeek OCR）",
        "ja": "画像の全文認識（DeepSeek OCR）",
        "ko": "이미지 전체 텍스트 인식 (DeepSeek OCR)",
        "tr": "Görüntü metni tanıma (DeepSeek OCR)",
        "vi": "Nhận dạng văn bản trong ảnh (DeepSeek OCR)",
        "ru": "Распознавание текста на изображении (DeepSeek OCR)"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/deepseek-ocr.js"
      },
      "capabilities": {
        "parseImage": {
          "handler": "parseImage",
          "inputModalities": [
            "image"
          ],
          "outputModes": [
            "complete"
          ],
          "taskModes": [
            "doc"
          ]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "zh": "模型 ID",
            "en": "Model ID",
            "zh_TW": "模型 ID",
            "ja": "モデル ID",
            "ko": "모델 ID",
            "tr": "Model kimliği",
            "vi": "ID mô hình",
            "ru": "ID модели"
          },
          "type": "text",
          "defaultValue": "deepseek-ai/DeepSeek-OCR",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "deepseek-ai/DeepSeek-OCR",
          "name": "DeepSeek-OCR"
        }
      ],
      "defaultPrompts": {
        "vlm": {
          "userPrompt": "Free OCR."
        }
      }
    }
  ]
}
