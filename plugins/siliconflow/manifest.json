{
  "manifestVersion": 1,
  "id": "siliconflow",
  "name": "硅基流动 SiliconFlow",
  "nameI18n": {
    "en": "SiliconFlow"
  },
  "version": "1.0.0",
  "apiVersion": "1",
  "description": "DeepSeek 聊天与翻译、Qwen 和星辰音频转写，以及 PaddleOCR 和 DeepSeek OCR 全文识别。",
  "descriptionI18n": {
    "en": "DeepSeek chat and translation, Qwen and XingChen audio transcription, and full-text recognition with PaddleOCR and DeepSeek OCR."
  },
  "permissions": {
    "network": ["https://api.siliconflow.cn"],
    "endpointFields": ["baseUrl"]
  },
  "sharedSettings": [
    {
      "key": "baseUrl",
      "label": "API 基础地址（包含 /v1）",
      "labelI18n": {
        "en": "API base URL (including /v1)"
      },
      "type": "text",
      "defaultValue": "https://api.siliconflow.cn/v1",
      "required": true
    },
    {
      "key": "apiKey",
      "label": "SiliconFlow API Key",
      "type": "password",
      "isSecret": true,
      "required": true
    }
  ],
  "services": [
    {
      "id": "chat-completions",
      "name": "DeepSeek-V4.1-Flash 聊天与翻译",
      "nameI18n": {
        "en": "DeepSeek-V4.1-Flash chat and translation"
      },
      "implementation": {
        "kind": "declarative",
        "entry": "services/chat.json"
      },
      "capabilities": {
        "chat": {
          "handler": "chat",
          "inputModalities": ["text"],
          "outputModes": ["complete", "stream"]
        },
        "translate": {
          "handler": "translate",
          "batch": {
            "supported": true
          },
          "outputModes": ["complete", "stream"]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "en": "Model ID"
          },
          "type": "text",
          "defaultValue": "deepseek-ai/DeepSeek-V4.1-Flash",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "deepseek-ai/DeepSeek-V4.1-Flash",
          "name": "DeepSeek-V4.1-Flash"
        }
      ],
      "defaultPrompts": {
        "batch": {
          "protocol": "json",
          "systemPrompt": "Translate the input items from {{sourceLanguage}} to {{targetLanguage}}. Return only a JSON array of {id,text}, keeping every ID. Glossary: {{glossary}}. Context: {{context}}",
          "userPrompt": "{{segments}}"
        },
        "nobatch": {
          "protocol": "text",
          "systemPrompt": "Translate the source text from {{sourceLanguage}} to {{targetLanguage}}. Output only the translated text, without explanations or Markdown fences. Glossary: {{glossary}}. Context: {{context}}",
          "userPrompt": "{{text}}"
        }
      }
    },
    {
      "id": "qwen-transcriptions",
      "name": "Qwen3-ASR-1.7B 音频转写",
      "nameI18n": {
        "en": "Qwen3-ASR-1.7B audio transcription"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/transcribe.js"
      },
      "capabilities": {
        "transcribe": {
          "handler": "transcribe",
          "outputModes": ["complete"]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "en": "Model ID"
          },
          "type": "text",
          "defaultValue": "Qwen/Qwen3-ASR-1.7B",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "Qwen/Qwen3-ASR-1.7B",
          "name": "Qwen3-ASR-1.7B"
        }
      ]
    },
    {
      "id": "xingchen-transcriptions",
      "name": "XingChenASR-V3.2-Ultra 音频转写",
      "nameI18n": {
        "en": "XingChenASR-V3.2-Ultra audio transcription"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/transcribe.js"
      },
      "capabilities": {
        "transcribe": {
          "handler": "transcribe",
          "outputModes": ["complete"]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "en": "Model ID"
          },
          "type": "text",
          "defaultValue": "XingChenAGI/XingChenASR-V3.2-Ultra",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "XingChenAGI/XingChenASR-V3.2-Ultra",
          "name": "XingChenASR-V3.2-Ultra"
        }
      ]
    },
    {
      "id": "paddleocr",
      "name": "PaddleOCR-VL-1.5 全文识别",
      "nameI18n": {
        "en": "PaddleOCR-VL-1.5 full-text recognition"
      },
      "implementation": {
        "kind": "declarative",
        "entry": "services/ocr.json"
      },
      "capabilities": {
        "parseImage": {
          "handler": "parseImage",
          "inputModalities": ["image"],
          "outputModes": ["complete"],
          "taskModes": ["doc"]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "en": "Model ID"
          },
          "type": "text",
          "defaultValue": "PaddlePaddle/PaddleOCR-VL-1.5",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "PaddlePaddle/PaddleOCR-VL-1.5",
          "name": "PaddleOCR-VL-1.5"
        }
      ],
      "defaultPrompts": {
        "vlm": {
          "userPrompt": "OCR:"
        }
      }
    },
    {
      "id": "deepseek-ocr",
      "name": "DeepSeek-OCR 全文识别",
      "nameI18n": {
        "en": "DeepSeek-OCR full-text recognition"
      },
      "implementation": {
        "kind": "script",
        "entry": "services/deepseek-ocr.js"
      },
      "capabilities": {
        "parseImage": {
          "handler": "parseImage",
          "inputModalities": ["image"],
          "outputModes": ["complete"],
          "taskModes": ["doc"]
        }
      },
      "settings": [
        {
          "key": "model",
          "label": "模型 ID",
          "labelI18n": {
            "en": "Model ID"
          },
          "type": "text",
          "defaultValue": "deepseek-ai/DeepSeek-OCR",
          "required": true
        }
      ],
      "modelField": "model",
      "models": [
        {
          "id": "deepseek-ai/DeepSeek-OCR",
          "name": "DeepSeek-OCR"
        }
      ],
      "defaultPrompts": {
        "vlm": {
          "userPrompt": "Free OCR."
        }
      }
    }
  ]
}
