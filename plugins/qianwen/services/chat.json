{
  "format": "protocol",
  "handlers": {
    "chat": {
      "protocol": "openai-chat-completions",
      "task": "chat",
      "request": {
        "baseUrl": "https://maas.qianwenaiapi.com/compatible-mode/v1",
        "model": {
          "$ref": "config.model"
        },
        "auth": {
          "type": "bearer",
          "secret": {
            "$secret": "apiKey"
          }
        },
        "parameters": {
          "enable_thinking": {
            "$if": {
              "$ref": "config.thinkingMode",
              "equals": "auto"
            },
            "else": {
              "$if": {
                "$ref": "config.thinkingMode",
                "equals": "enabled"
              },
              "then": true,
              "else": false
            }
          }
        }
      }
    },
    "translate": {
